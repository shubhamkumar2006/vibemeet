# Supabase project settings (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key



# Generate a random secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret

# LiveKit Cloud project settings
# Browser URL is usually wss://<project>.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
# Optional HTTPS server URL for server-side room controls; defaults to LIVEKIT_URL converted to https://
LIVEKIT_API_URL=https://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
